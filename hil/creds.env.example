# Valid credentials for the HIL tests (hil/firmware/conftest.py).
# Copy to ~/.config/hil/creds.env, fill in, then chmod 600. Never commit it.
# build-hil.yml sources that file on the HIL runner; for manual runs, add to
# ~/.bashrc:
#   if [ -f ~/.config/hil/creds.env ]; then set -a; . ~/.config/hil/creds.env; set +a; fi
HIL_IO_USERNAME=DEFAULT_IO_USERNAME
HIL_IO_KEY=DEFAULT_IO_KEY
HIL_WIFI_SSID=DEFAULT_SSID_NAME
HIL_WIFI_PASSWORD=DEFAULT_WIFI_PASSWORD
# Optional. Each test runs a ProtoMQ broker on this host and points the
# DUT at it. The address the DUT reaches this host at (default its LAN IP),
# the MQTT port (default 1884), the API/web UI port (default a free port)
# and the ProtoMQ checkout (default ~/ProtoMQ):
# HIL_PROTOMQ_HOST=192.168.1.10
HIL_PROTOMQ_PORT=1884
HIL_PROTOMQ_HTTP_PORT=5173
HIL_PROTOMQ_DIR=~/ProtoMQ
# Optional, the Wippersnapper_Boards checkout (board definitions, for the
# checkin tests), default ~/Wippersnapper_Boards:
HIL_WS_BOARDS_DIR=~/Wippersnapper_Boards
