# Valid credentials for the HIL tests (hil/firmware/conftest.py).
# Copy to ~/.config/hil/creds.env, fill in, then chmod 600. Never commit it.
# build-hil.yml sources that file on the HIL runner; for manual runs, add to
# ~/.bashrc:
#   if [ -f ~/.config/hil/creds.env ]; then set -a; . ~/.config/hil/creds.env; set +a; fi
HIL_IO_USERNAME=DEFAULT_IO_USERNAME
HIL_IO_KEY=DEFAULT_IO_KEY
HIL_WIFI_SSID=DEFAULT_SSID_NAME
HIL_WIFI_PASSWORD=DEFAULT_WIFI_PASSWORD
# Optional, default io.adafruit.com and 8883:
HIL_IO_URL=io.adafruit.com
HIL_IO_PORT=8883
